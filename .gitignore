# --- Project docs (design/progress notes stay local, untracked) ---
*.md
# The threat model is tracked so security scans can start from it.
!SECURITY_MODEL.md

# --- Secrets & local env (NEVER commit) ---
.env
.env.*
certs/
*.pem
*.key

# --- Rust (services/vault-signer) ---
target/
Cargo.lock.bak

# --- Go ---
*.test
*.out

# --- Node / Next.js (web) ---
node_modules/
.next/
dist/
*.tsbuildinfo

# --- Foundry (contracts) ---
contracts/cache/
contracts/out/
contracts/broadcast/

# --- Deploy runtime artifacts (regenerated by scripts/deploy-and-seed.sh; contains dev keys) ---
deploy/*.env
deploy/*.json
deploy/*.sql
deploy/signer-data/
deploy/anvil
deploy/cast
deploy/vault-signer

# --- Misc ---
*.log
coverage/
.DS_Store
